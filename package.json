{
  "name": "lens",
  "version": "1.0.0",
  "private": true,
  "description": "Lens: Smart Image Gallery with Semantic Search",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.1",
    "pnpm": ">=11.19.0"
  },
  "scripts": {
    "setup:infra": "pnpm run setup:local-db",
    "setup:local-db": "pnpm --filter=@lens/engine run setup:local-db",
    "dev:backend": "pnpm --filter=@lens/engine run dev",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r run typecheck"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.24.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@heroui/shared-utils"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "packageManager": "pnpm@11.19.0"
}
