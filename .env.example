# ==============================================================================
# Lens Environment Variables Template
# Copy this file to apps/engine/.dev.vars for local development with Wrangler:
#   cp .env.example apps/engine/.dev.vars
# For production deployment, set secrets via Wrangler CLI:
#   wrangler secret put UNSPLASH_API_KEY
#   wrangler secret put CLOUDFLARE_API_TOKEN
# ==============================================================================

# Unsplash Image Ingestion API Access Key (https://unsplash.com/developers)
# Required for cron ingestion pipeline. Rate limited to 50 requests/hour on demo tier.
UNSPLASH_API_KEY=your_unsplash_access_key_here

# Cloudflare Account ID (Cloudflare Dashboard: dash.cloudflare.com/<ACCOUNT_ID>)
# Required for AI Gateway GraphQL usage telemetry and cost audits.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Cloudflare API Token with AI Gateway Read permissions
# Required for the billing guardian service to monitor Workers AI usage.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Optional: Local development environment identifier
ENVIRONMENT=development
